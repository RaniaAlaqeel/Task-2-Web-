// Toggle status (حضور / غياب) - سطر واحد فقط
if (isset($_GET['toggle_id'])) {
    $id = intval($_GET['toggle_id']);

    $stmt = $conn->prepare("UPDATE user SET Status = IF(Status = 1, 0, 1) WHERE Id = ?");
    $stmt->bind_param("i", $id);
    $stmt->execute();
    $stmt->close();

    header("Location: in.php");
    exit();
}

// Delete single row - سطر واحد فقط
if (isset($_GET['delete_id'])) {
    $id = intval($_GET['delete_id']);

