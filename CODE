// ------------------------------------------------------------------

// تحقق: هل عمود Id عنده Primary Key فعلاً؟
$check = $conn->query("SHOW KEYS FROM user WHERE Key_name = 'PRIMARY'");

if ($check && $check->num_rows == 0) {
    // ما فيه Primary Key -> نصلح الجدول

    // نفرغ الجدول أول (لازم لأن القيم الحالية لعمود Id كلها مكررة/صفر)
    $conn->query("TRUNCATE TABLE user");

    // نخلي Id يتزايد تلقائيًا ونضيف له Primary Key
    $conn->query("ALTER TABLE user MODIFY Id INT NOT NULL AUTO_INCREMENT, ADD PRIMARY KEY (Id)");
}

